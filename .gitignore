# project-local tooling, caches and model weights (never committed)
.tools/
.cache/
.venv/
__pycache__/
*.pyc

# generated images are reproducible from seeds; manifests are committed instead
stimuli/**/*.png
!stimuli/**/contact_*.png

# the cleaned public copy of this repo is its own git repository
public_release/

# secrets never live in files, but belt and braces
.env
*.key
